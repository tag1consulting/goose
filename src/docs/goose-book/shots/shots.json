{
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "scale": 2,
    "colorScheme": "light",
    "locale": "en-US"
  },
  "runs": {
    "control": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "prelude": [
        [
          "--report-file",
          "--notes",
          "25 users",
          "-u",
          "25",
          "-r",
          "5",
          "-t",
          "60s",
          "-q"
        ],
        [
          "--report-file",
          "--notes",
          "50 users",
          "-u",
          "50",
          "-r",
          "5",
          "-t",
          "60s",
          "-q"
        ]
      ],
      "flags": [
        "--dashboard",
        "--dashboard-control",
        "--dashboard-no-auth",
        "-u",
        "100",
        "-r",
        "1",
        "--no-reset-metrics",
        "-t",
        "10m",
        "--notes",
        "100, then 150 users",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118",
      "events": [
        {
          "name": "raise users to 150",
          "at": 120,
          "actions": [
            {
              "do": "fill",
              "selector": "#ctrl-target",
              "value": "150"
            },
            {
              "do": "click",
              "selector": "#ctrl-apply"
            }
          ]
        },
        {
          "name": "stop and wait for Idle",
          "at": 215,
          "actions": [
            {
              "do": "click",
              "selector": "#ctrl-stop"
            },
            {
              "do": "waitFor",
              "selector": "#phase-badge",
              "text": "^(idle|IDLE)$"
            },
            {
              "do": "wait",
              "seconds": 3
            }
          ]
        }
      ]
    },
    "read-only": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "-u",
        "20",
        "-r",
        "5",
        "-t",
        "3m",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118"
    },
    "errors": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "env": {
        "ADMIN_PASSWORD": "not-the-password"
      },
      "flags": [
        "--dashboard",
        "-u",
        "50",
        "-r",
        "5",
        "-t",
        "3m",
        "--no-reset-metrics",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118",
      "allowFailures": true
    },
    "test-plan": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "--test-plan",
        "20,20s;20,40s;60,20s;60,40s;20,20s;20,60s;0,0s",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118"
    },
    "front-door": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "-u",
        "50",
        "-r",
        "1",
        "--no-reset-metrics",
        "-t",
        "3m",
        "-q"
      ]
    },
    "report": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "--dashboard-control",
        "--dashboard-no-auth",
        "--report-file",
        "-u",
        "50",
        "-r",
        "1",
        "--no-reset-metrics",
        "-t",
        "2m",
        "-q"
      ]
    },
    "example-simple": {
      "example": "simple",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_HTTP}",
      "flags": [
        "-u",
        "1024",
        "-r",
        "64",
        "-t",
        "3m",
        "--no-reset-metrics",
        "--dashboard",
        "-q"
      ]
    },
    "example-closure": {
      "example": "closure",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_HTTP}",
      "flags": [
        "-u",
        "200",
        "-r",
        "50",
        "-t",
        "3m",
        "--no-reset-metrics",
        "--dashboard",
        "-q"
      ]
    },
    "example-session": {
      "example": "session",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_SESSION}",
      "flags": [
        "-u",
        "100",
        "-r",
        "20",
        "-t",
        "2m",
        "--no-reset-metrics",
        "--report-file",
        "--dashboard",
        "-q"
      ]
    },
    "example-basic-auth": {
      "example": "basic_auth",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_HTTP}",
      "flags": [
        "-u",
        "60",
        "-r",
        "20",
        "-t",
        "2m",
        "--no-reset-metrics",
        "--report-file",
        "--dashboard",
        "-q"
      ]
    },
    "example-graphql": {
      "example": "graphql_loadtest",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_GRAPHQL}",
      "flags": [
        "-u",
        "5",
        "-r",
        "5",
        "-t",
        "3m",
        "--no-reset-metrics",
        "--dashboard",
        "-q"
      ]
    },
    "example-tcp": {
      "example": "tcp_loadtest",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_TCP}",
      "flags": [
        "-u",
        "10",
        "-r",
        "10",
        "-t",
        "3m",
        "--no-reset-metrics",
        "--dashboard",
        "-q"
      ]
    },
    "example-umami": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "-u",
        "50",
        "-r",
        "5",
        "-t",
        "3m",
        "--no-reset-metrics",
        "--dashboard",
        "-q"
      ]
    },
    "metrics": {
      "example": "umami",
      "features": [
        "dashboard",
        "pdf-reports"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "-u",
        "50",
        "-r",
        "5",
        "-t",
        "3m",
        "--report-file",
        "report.pdf",
        "--report-file",
        "report.html",
        "--report-file",
        "report.md",
        "--report-file",
        "report.json",
        "--dashboard-port",
        "5128",
        "--telnet-port",
        "5126"
      ],
      "dashboard": "http://127.0.0.1:5128"
    },
    "co-average": {
      "example": "graphql_loadtest",
      "features": [
        "dashboard"
      ],
      "target": "http://127.0.0.1:18900",
      "server": {
        "command": "${GOOSE_SHOTS_STALL_SERVER}",
        "args": [
          "--port",
          "18900",
          "--every",
          "1000",
          "--stall-ms",
          "1000",
          "--min-ms",
          "5",
          "--max-ms",
          "15"
        ],
        "ready": "http://127.0.0.1:18900/stats"
      },
      "flags": [
        "--dashboard",
        "-u",
        "10",
        "-r",
        "10",
        "-t",
        "2m",
        "--co-mitigation",
        "average",
        "--report-file",
        "report.html",
        "--report-file",
        "report.md",
        "--report-file",
        "report.json"
      ]
    },
    "gaggle-six": {
      "example": "simple",
      "features": [
        "dashboard",
        "gaggle"
      ],
      "target": "${GOOSE_SHOTS_HTTP}",
      "gaggle": {
        "workers": 6,
        "name": "load-{n}",
        "port": 5135
      },
      "flags": [
        "--dashboard",
        "--dashboard-control",
        "--dashboard-auth-token",
        "gaggle-shots-token",
        "--gaggle-rebalance",
        "--no-telnet",
        "-q",
        "-u",
        "120",
        "-r",
        "20",
        "--throttle-requests",
        "60",
        "-t",
        "10m"
      ],
      "token": "gaggle-shots-token",
      "dashboard": "http://127.0.0.1:5118",
      "limit": 900,
      "console": true,
      "allowFailures": true,
      "attempts": 1,
      "events": [
        {
          "name": "users 120 to 180 from the dashboard",
          "at": 120,
          "actions": [
            {
              "do": "fill",
              "selector": "#ctrl-target",
              "value": "180"
            },
            {
              "do": "click",
              "selector": "#ctrl-apply"
            }
          ]
        },
        {
          "name": "throttle 60 to 30 from the dashboard",
          "at": 180,
          "actions": [
            {
              "do": "fill",
              "selector": "#ctrl-throttle",
              "value": "30"
            },
            {
              "do": "click",
              "selector": "#ctrl-throttle-apply"
            }
          ]
        },
        {
          "name": "lose worker 3",
          "at": 240,
          "actions": [
            {
              "do": "signal",
              "worker": 3,
              "signal": "SIGKILL"
            }
          ]
        },
        {
          "name": "a CPU hog on every core",
          "at": 300,
          "actions": [
            {
              "do": "hog",
              "seconds": 120
            }
          ]
        },
        {
          "name": "stop worker 4",
          "at": 390,
          "actions": [
            {
              "do": "signal",
              "worker": 4,
              "signal": "SIGSTOP"
            }
          ]
        },
        {
          "name": "continue worker 4",
          "at": 396,
          "actions": [
            {
              "do": "signal",
              "worker": 4,
              "signal": "SIGCONT"
            }
          ]
        }
      ]
    },
    "gaggle-48": {
      "example": "simple",
      "features": [
        "dashboard",
        "gaggle"
      ],
      "target": "${GOOSE_SHOTS_HTTP}",
      "gaggle": {
        "workers": 48,
        "name": "load-{n}",
        "port": 5135
      },
      "flags": [
        "--dashboard",
        "--dashboard-control",
        "--dashboard-auth-token",
        "gaggle-shots-token",
        "--gaggle-rebalance",
        "--no-telnet",
        "-q",
        "-u",
        "240",
        "-r",
        "40",
        "--throttle-requests",
        "96",
        "-t",
        "6m"
      ],
      "token": "gaggle-shots-token",
      "dashboard": "http://127.0.0.1:5118",
      "limit": 660,
      "console": true,
      "allowFailures": true,
      "attempts": 1,
      "events": [
        {
          "name": "users 240 to 288 from the dashboard",
          "at": 120,
          "actions": [
            {
              "do": "fill",
              "selector": "#ctrl-target",
              "value": "288"
            },
            {
              "do": "click",
              "selector": "#ctrl-apply"
            }
          ]
        },
        {
          "name": "throttle 96 to 144 from the dashboard",
          "at": 150,
          "actions": [
            {
              "do": "fill",
              "selector": "#ctrl-throttle",
              "value": "144"
            },
            {
              "do": "click",
              "selector": "#ctrl-throttle-apply"
            }
          ]
        },
        {
          "name": "lose worker 31",
          "at": 185,
          "actions": [
            {
              "do": "signal",
              "worker": 31,
              "signal": "SIGKILL"
            }
          ]
        },
        {
          "name": "a CPU hog on every core",
          "at": 210,
          "actions": [
            {
              "do": "hog",
              "seconds": 120
            }
          ]
        },
        {
          "name": "stop worker 42",
          "at": 245,
          "actions": [
            {
              "do": "signal",
              "worker": 42,
              "signal": "SIGSTOP"
            }
          ]
        },
        {
          "name": "continue worker 42",
          "at": 251,
          "actions": [
            {
              "do": "signal",
              "worker": 42,
              "signal": "SIGCONT"
            }
          ]
        }
      ]
    }
  },
  "shots": [
    {
      "name": "dashboard-hero",
      "output": "controller/dashboard-hero.png",
      "run": "control",
      "at": 100,
      "capture": {
        "type": "viewport",
        "column": "#kpis",
        "pad": 16,
        "ready": "#chart-rps-summary"
      }
    },
    {
      "name": "dashboard-rps",
      "output": "controller/dashboard-rps.png",
      "run": "control",
      "at": 200,
      "capture": {
        "type": "element",
        "selector": "#charts > .chart-card:nth-child(1)"
      }
    },
    {
      "name": "dashboard-users",
      "output": "controller/dashboard-users.png",
      "run": "control",
      "at": 200,
      "capture": {
        "type": "element",
        "selector": "#charts > .chart-card:nth-child(2)"
      }
    },
    {
      "name": "dashboard-heatmap",
      "output": "controller/dashboard-heatmap.png",
      "run": "control",
      "at": 202,
      "capture": {
        "type": "element",
        "selector": "#chart-latency-card"
      }
    },
    {
      "name": "dashboard-requests",
      "output": "controller/dashboard-requests.png",
      "run": "control",
      "at": 205,
      "actions": [
        {
          "do": "click",
          "selector": "#requests-table th[data-sort=p95]"
        },
        {
          "do": "wait",
          "seconds": 1
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#requests",
        "height": 543,
        "width": 1130
      }
    },
    {
      "name": "dashboard-settings",
      "output": "controller/dashboard-settings.png",
      "run": "control",
      "at": 225,
      "actions": [
        {
          "do": "open",
          "selector": "#ctrl-settings"
        },
        {
          "do": "fill",
          "selector": "#set-host",
          "value": "http://127.0.0.1:18888"
        },
        {
          "do": "fill",
          "selector": "#set-up",
          "value": "10"
        },
        {
          "do": "select",
          "selector": "#set-up-unit",
          "value": "rate"
        },
        {
          "do": "fill",
          "selector": "#set-run",
          "value": "5"
        },
        {
          "do": "select",
          "selector": "#set-run-unit",
          "value": "min"
        },
        {
          "do": "click",
          "selector": "#ctrl-start"
        },
        {
          "do": "waitFor",
          "selector": "#set-host-confirm-text",
          "text": "Load will go to"
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#control-panel"
      }
    },
    {
      "name": "dashboard-runs",
      "output": "controller/dashboard-runs.png",
      "run": "control",
      "at": 230,
      "actions": [
        {
          "do": "click",
          "selector": "#set-host-confirm-cancel"
        },
        {
          "do": "check",
          "selector": "#runs-body tr:nth-child(1) .run-compare"
        },
        {
          "do": "check",
          "selector": "#runs-body tr:nth-child(2) .run-compare"
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#runs-panel"
      }
    },
    {
      "name": "dashboard-read-only",
      "output": "controller/dashboard-read-only.png",
      "run": "read-only",
      "at": 95,
      "capture": {
        "type": "element",
        "selector": "#control-panel"
      }
    },
    {
      "name": "dashboard-errors",
      "output": "controller/dashboard-errors.png",
      "run": "errors",
      "at": 100,
      "capture": {
        "type": "element",
        "selector": "#errors"
      }
    },
    {
      "name": "test-plan-dashboard",
      "output": "getting-started/test-plan-dashboard.png",
      "run": "test-plan",
      "at": 190,
      "capture": {
        "type": "element",
        "selector": "#charts > .chart-card:nth-child(2)"
      }
    },
    {
      "name": "title-dashboard",
      "output": "title-dashboard.png",
      "run": "front-door",
      "at": 150,
      "capture": {
        "type": "band",
        "from": "#kpis",
        "to": "#chart-latency-card",
        "pad": 8
      }
    },
    {
      "name": "common-dashboard",
      "output": "getting-started/common-dashboard.png",
      "run": "front-door",
      "at": 135,
      "capture": {
        "type": "band",
        "from": "header.top-bar",
        "to": "#charts > .chart-card:nth-child(2)",
        "pad": 8
      }
    },
    {
      "name": "report-rps",
      "output": "getting-started/rps.png",
      "run": "report",
      "at": 190,
      "capture": {
        "type": "report",
        "file": "report.html",
        "selector": "#graph-rps"
      }
    },
    {
      "name": "example-simple",
      "output": "example/simple-dashboard.png",
      "run": "example-simple",
      "at": 120,
      "capture": {
        "type": "band",
        "from": "#kpis",
        "to": "#charts > .chart-card:nth-child(1)",
        "right": "#charts > .chart-card:nth-child(1)"
      }
    },
    {
      "name": "example-thumb-simple",
      "output": "example/thumbs/simple.png",
      "run": "example-simple",
      "at": 121,
      "maxKB": 100,
      "capture": {
        "type": "element",
        "selector": "#kpis",
        "right": "#kpis > .kpi:nth-child(2)"
      }
    },
    {
      "name": "example-closure",
      "output": "example/closure-requests.png",
      "run": "example-closure",
      "at": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(7)"
      }
    },
    {
      "name": "example-thumb-closure",
      "output": "example/thumbs/closure.png",
      "run": "example-closure",
      "at": 101,
      "maxKB": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(4)",
        "height": 270
      }
    },
    {
      "name": "example-thumb-session",
      "output": "example/thumbs/session.png",
      "run": "example-session",
      "at": 100,
      "maxKB": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(4)",
        "height": 270
      }
    },
    {
      "name": "example-session",
      "output": "example/session-requests.png",
      "run": "example-session",
      "at": 150,
      "capture": {
        "type": "report",
        "file": "report.html",
        "selector": ".requests table",
        "right": ".requests table th:nth-child(4)"
      }
    },
    {
      "name": "example-thumb-basic-auth",
      "output": "example/thumbs/basic-auth.png",
      "run": "example-basic-auth",
      "at": 100,
      "maxKB": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(4)",
        "height": 270,
        "bottom": "#requests-table tbody tr:nth-child(4)"
      }
    },
    {
      "name": "example-basic-auth-requests",
      "output": "example/basic-auth-requests.png",
      "run": "example-basic-auth",
      "at": 150,
      "capture": {
        "type": "report",
        "file": "report.html",
        "selector": ".requests table",
        "right": ".requests table th:nth-child(4)"
      }
    },
    {
      "name": "example-basic-auth-transactions",
      "output": "example/basic-auth-transactions.png",
      "run": "example-basic-auth",
      "at": 151,
      "capture": {
        "type": "report",
        "file": "report.html",
        "selector": ".transactions table",
        "right": ".transactions table th:nth-child(3)"
      }
    },
    {
      "name": "example-graphql-transactions",
      "output": "example/graphql-transactions.png",
      "run": "example-graphql",
      "at": 100,
      "capture": {
        "type": "element",
        "selector": "#transactions",
        "right": "#transactions-table th:nth-child(8)"
      }
    },
    {
      "name": "example-graphql-requests",
      "output": "example/graphql-requests.png",
      "run": "example-graphql",
      "at": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(7)"
      }
    },
    {
      "name": "example-thumb-graphql",
      "output": "example/thumbs/graphql.png",
      "run": "example-graphql",
      "at": 101,
      "maxKB": 100,
      "capture": {
        "type": "element",
        "selector": "#transactions-table",
        "right": "#transactions-table th:nth-child(4)"
      }
    },
    {
      "name": "example-tcp-requests",
      "output": "example/tcp-requests.png",
      "run": "example-tcp",
      "at": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(7)"
      }
    },
    {
      "name": "example-tcp-latency",
      "output": "example/tcp-latency.png",
      "run": "example-tcp",
      "at": 102,
      "actions": [
        {
          "do": "select",
          "selector": "#heatmap-request",
          "value": "TCP tcp_echo"
        },
        {
          "do": "wait",
          "seconds": 2
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#chart-latency-card",
        "width": 800
      }
    },
    {
      "name": "example-thumb-tcp",
      "output": "example/thumbs/tcp.png",
      "run": "example-tcp",
      "at": 101,
      "maxKB": 100,
      "capture": {
        "type": "element",
        "selector": "#requests",
        "right": "#requests-table th:nth-child(4)",
        "height": 270
      }
    },
