{
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "scale": 2,
    "colorScheme": "light",
    "locale": "en-US"
  },
  "runs": {
    "control": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "prelude": [
        [
          "--report-file",
          "--notes",
          "25 users",
          "-u",
          "25",
          "-r",
          "5",
          "-t",
          "60s",
          "-q"
        ],
        [
          "--report-file",
          "--notes",
          "50 users",
          "-u",
          "50",
          "-r",
          "5",
          "-t",
          "60s",
          "-q"
        ]
      ],
      "flags": [
        "--dashboard",
        "--dashboard-control",
        "--dashboard-no-auth",
        "-u",
        "100",
        "-r",
        "1",
        "--no-reset-metrics",
        "-t",
        "10m",
        "--notes",
        "100, then 150 users",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118",
      "events": [
        {
          "name": "raise users to 150",
          "at": 120,
          "actions": [
            {
              "do": "fill",
              "selector": "#ctrl-target",
              "value": "150"
            },
            {
              "do": "click",
              "selector": "#ctrl-apply"
            }
          ]
        },
        {
          "name": "stop and wait for Idle",
          "at": 215,
          "actions": [
            {
              "do": "click",
              "selector": "#ctrl-stop"
            },
            {
              "do": "waitFor",
              "selector": "#phase-badge",
              "text": "^(idle|IDLE)$"
            },
            {
              "do": "wait",
              "seconds": 3
            }
          ]
        }
      ]
    },
    "read-only": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "-u",
        "20",
        "-r",
        "5",
        "-t",
        "3m",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118"
    },
    "errors": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "env": {
        "ADMIN_PASSWORD": "not-the-password"
      },
      "flags": [
        "--dashboard",
        "-u",
        "50",
        "-r",
        "5",
        "-t",
        "3m",
        "--no-reset-metrics",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118",
      "allowFailures": true
    },
    "test-plan": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "--test-plan",
        "20,20s;20,40s;60,20s;60,40s;20,20s;20,60s;0,0s",
        "-q"
      ],
      "dashboard": "http://127.0.0.1:5118"
    },
    "front-door": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "-u",
        "50",
        "-r",
        "1",
        "--no-reset-metrics",
        "-t",
        "3m",
        "-q"
      ]
    },
    "report": {
      "example": "umami",
      "features": [
        "dashboard"
      ],
      "target": "${GOOSE_SHOTS_UMAMI}",
      "flags": [
        "--dashboard",
        "--dashboard-control",
        "--dashboard-no-auth",
        "--report-file",
        "-u",
        "50",
        "-r",
        "1",
        "--no-reset-metrics",
        "-t",
        "2m",
        "-q"
      ]
    }
  },
  "shots": [
    {
      "name": "dashboard-hero",
      "output": "controller/dashboard-hero.png",
      "run": "control",
      "at": 100,
      "capture": {
        "type": "viewport",
        "column": "#kpis",
        "pad": 16,
        "ready": "#chart-rps-summary"
      }
    },
    {
      "name": "dashboard-rps",
      "output": "controller/dashboard-rps.png",
      "run": "control",
      "at": 200,
      "capture": {
        "type": "element",
        "selector": "#charts > .chart-card:nth-child(1)"
      }
    },
    {
      "name": "dashboard-users",
      "output": "controller/dashboard-users.png",
      "run": "control",
      "at": 200,
      "capture": {
        "type": "element",
        "selector": "#charts > .chart-card:nth-child(2)"
      }
    },
    {
      "name": "dashboard-heatmap",
      "output": "controller/dashboard-heatmap.png",
      "run": "control",
      "at": 202,
      "capture": {
        "type": "element",
        "selector": "#chart-latency-card"
      }
    },
    {
      "name": "dashboard-requests",
      "output": "controller/dashboard-requests.png",
      "run": "control",
      "at": 205,
      "actions": [
        {
          "do": "click",
          "selector": "#requests-table th[data-sort=p95]"
        },
        {
          "do": "wait",
          "seconds": 1
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#requests",
        "height": 543,
        "width": 1130
      }
    },
    {
      "name": "dashboard-settings",
      "output": "controller/dashboard-settings.png",
      "run": "control",
      "at": 225,
      "actions": [
        {
          "do": "open",
          "selector": "#ctrl-settings"
        },
        {
          "do": "fill",
          "selector": "#set-host",
          "value": "http://127.0.0.1:18888"
        },
        {
          "do": "fill",
          "selector": "#set-up",
          "value": "10"
        },
        {
          "do": "select",
          "selector": "#set-up-unit",
          "value": "rate"
        },
        {
          "do": "fill",
          "selector": "#set-run",
          "value": "5"
        },
        {
          "do": "select",
          "selector": "#set-run-unit",
          "value": "min"
        },
        {
          "do": "click",
          "selector": "#ctrl-start"
        },
        {
          "do": "waitFor",
          "selector": "#set-host-confirm-text",
          "text": "Load will go to"
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#control-panel"
      }
    },
    {
      "name": "dashboard-runs",
      "output": "controller/dashboard-runs.png",
      "run": "control",
      "at": 230,
      "actions": [
        {
          "do": "click",
          "selector": "#set-host-confirm-cancel"
        },
        {
          "do": "check",
          "selector": "#runs-body tr:nth-child(1) .run-compare"
        },
        {
          "do": "check",
          "selector": "#runs-body tr:nth-child(2) .run-compare"
        }
      ],
      "capture": {
        "type": "element",
        "selector": "#runs-panel"
      }
    },
    {
      "name": "dashboard-read-only",
      "output": "controller/dashboard-read-only.png",
      "run": "read-only",
      "at": 95,
      "capture": {
        "type": "element",
        "selector": "#control-panel"
      }
    },
    {
      "name": "dashboard-errors",
      "output": "controller/dashboard-errors.png",
      "run": "errors",
      "at": 100,
      "capture": {
        "type": "element",
        "selector": "#errors"
      }
    },
    {
      "name": "test-plan-dashboard",
      "output": "getting-started/test-plan-dashboard.png",
      "run": "test-plan",
      "at": 190,
      "capture": {
        "type": "element",
        "selector": "#charts > .chart-card:nth-child(2)"
      }
    },
    {
      "name": "common-dashboard",
      "output": "getting-started/common-dashboard.png",
      "run": "front-door",
      "at": 135,
      "capture": {
        "type": "band",
        "from": "header.top-bar",
        "to": "#charts > .chart-card:nth-child(2)",
        "pad": 8
      }
    },
    {
      "name": "report-rps",
      "output": "getting-started/rps.png",
      "run": "report",
      "at": 190,
      "capture": {
        "type": "report",
        "file": "report.html",
        "selector": "#graph-rps"
      }
    }
  ]
}
